# 这是「示例文件」，只说明有哪些配置项，可以安全提交到 Git。
#
# 实际生效的配置来自哪个文件，由运行环境决定（见 app/core/config.py）：
#   - 本地开发（无 PORT 环境变量）→ 读 backend/.env.local
#   - 线上部署（沙箱注入 PORT）   → 读 backend/.env.production
# 两个文件都含真实 Key、都被 .gitignore 忽略，也都不该提交。
# 本文件只放行示例值 —— 里面的 Key 一律留空。
#
# 环境变量的优先级高于任何配置文件。

# Application
APP_NAME=AI Research Workspace
ENVIRONMENT=development
VERSION=0.1.0
LOG_LEVEL=INFO

# API
API_PREFIX=/api

# CORS: 允许访问后端的浏览器来源，逗号分隔。
# 前端 dev server 默认端口是 5173；若 Vite 改成 5174，需要同步加进来。
# 填 "*" 时后端会自动关闭 allow_credentials（不使用 Cookie，公开站点更安全）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ----- 生产加固（可选，默认关闭；生产 .env.production 里打开）-----
# 昂贵端点限流：按 IP 的分钟级滑窗，保护 LLM / 搜索额度。
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS_PER_MINUTE=30
# 每日运行预算：按 IP 统计「新建运行」次数（POST /api/graph/research 与 POST /api/agent/run），
# 超限返回 429（daily_budget_exceeded），自然日自动归零。resume 不计数。
# DAILY_RUN_BUDGET_ENABLED=true
# DAILY_RUN_BUDGET_PER_IP=10

# ----- LLM：统一模型调用层 -----
# openai = 任意 OpenAI 兼容端点（DeepSeek / 通义 / Moonshot / 智谱 / 官方 OpenAI…）
# ollama = 本地推理后端，走原生 /api/chat（可用 keep_alive / think / num_ctx 等私有参数）
# mock   = 离线档位，不联网也能跑通全流程（CI 与无 Key 场景）
# auto   = 按可用性自动选择
# ⚠️ 换后端只改这一项（+ 对应的那一小组参数），业务代码零改动。
LLM_PROVIDER=openai

# ---- OpenAI 兼容端点 ----
# 常见服务（base_url 是否带 /v1 后缀各家不统一，以厂商文档为准）：
#   DeepSeek  https://api.deepseek.com                          + deepseek-chat
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
#   Moonshot  https://api.moonshot.cn/v1                        + moonshot-v1-8k
#   智谱      https://open.bigmodel.cn/api/paas/v4              + glm-4-flash
LLM_BASE_URL=
LLM_MODEL=

# API Key 只从环境变量读取，绝不写进代码或提交到 Git。
LLM_API_KEY=

# ---- 可选：本地推理后端 ----
# ⚠️ 原生地址，**不要加 /v1**：走 /api/chat 才能下发生成参数。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# 模型常驻显存时长：5m = 用完再留 5 分钟；0 = 立即卸载（省显存）
OLLAMA_KEEP_ALIVE=5m
# 思考型模型可关闭思考，显著降低延迟与推理 token 开销
OLLAMA_THINK=false
# 上下文窗口 / 单次生成上限（token）。结构化输出至少 4096，否则 JSON 会被截断。
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=4096
# 本地推理首 token 较慢，超时要给得比云端 API 宽
OLLAMA_TIMEOUT_SECONDS=120

# ---- 自动兜底（可选）----
# 置空 = 不兜底。填一个 provider 名 = 主后端不可用时自动落到它。
LLM_FALLBACK_PROVIDER=
# 连续几次连接失败判定为主后端不可用；判定后进入冷却，
# 冷却期内直连兜底、不再试探主后端（否则每次调用都要先空等一整段超时）。
LLM_FALLBACK_THRESHOLD=2
LLM_FALLBACK_COOLDOWN_SECONDS=120

# 单次调用超时（秒）。外部 API 必须设超时，否则一个卡死的请求会拖垮整个服务。
LLM_TIMEOUT_SECONDS=30
# 最多尝试几次（含第一次）。只对超时/限流/5xx 重试，认证失败不重试。
LLM_MAX_ATTEMPTS=3
# 温度：越低越确定。结构化输出场景建议 0~0.3
LLM_TEMPERATURE=0.2
# 单次回复的最大 token 数，控制成本与最坏耗时。
# ⚠️ 不要低于 4096：报告/计划是长 JSON，2000 会被中途截断（finish_reason=length）。
LLM_MAX_TOKENS=4096

# ----- Research Graph (LangGraph) -----
# Agent 运行记录的 SQLite 文件（与 LangGraph 的 checkpointer 互补）
AGENT_RUNS_DB_PATH=storage/agent_runs.db
# research 节点最多循环几轮（防无限循环的第一道闸）。
# 深度研究建议 ≥5：每轮只执行一次「决策 + 一个工具」，3 轮不足以覆盖多子问题。
GRAPH_MAX_ITERATIONS=5
# verify 判定「证据不足」时，最多回炉补充研究几次
GRAPH_MAX_VERIFY_ATTEMPTS=2

# ----- Agent / Tools -----
# 一次 Agent run 最多走几步（含最终回答）。防失控第一道闸。
AGENT_MAX_STEPS=6
# 整个 run 的墙钟时间上限（秒）。最后一道闸：无论模型怎么循环，到点就停。
AGENT_TOTAL_TIMEOUT_SECONDS=120
# 工具输出进入上下文前的最大字符数（防止上下文爆炸）
TOOL_OUTPUT_MAX_CHARS=3000
# 网页抓取域名白名单，逗号分隔。留空 = 不限制，但内网/回环/保留地址永远禁止。
FETCH_ALLOWED_DOMAINS=

# ----- 联网搜索 -----
# auto    = 有 TAVILY_API_KEY 走 Tavily 真实联网，没 Key 回退离线示例语料（推荐）
# tavily  = 强制真实联网（没 Key 会告警并回退离线）
# stub    = 始终离线示例语料
# 四种方案的取舍见 docs/search-strategy.md
SEARCH_PROVIDER=auto
# Tavily API Key（https://app.tavily.com/）。留空则搜索不联网，只匹配内置示例语料。
TAVILY_API_KEY=
# 检索深度，只接受下面两个值之一，写错（如拼成 advaned）会**启动即报错**：
#   basic    = 1 credit / 次  → 1000 credits 免费额度够约 1000 次搜索
#   advanced = 2 credit / 次  → 同额度只够约 500 次
# 默认 basic：用检索质量换额度。想换回 advanced 只改这一行，不用改代码。
SEARCH_DEPTH=basic

# ----- Search quota（联网搜索额度记账）-----
# 关闭后搜索照常工作，但不再预扣、不再有额度熔断与告警。
SEARCH_QUOTA_ENABLED=true
# 额度账本（SQLite），相对 backend/ 目录
SEARCH_QUOTA_DB_PATH=storage/search_quota.db
# 本期额度上限。Tavily 免费档 = 1000 credits/月；付费后改成对应数字即可。
SEARCH_QUOTA_MONTHLY_CREDITS=1000
# 预警档位（用量占上限的比例），逗号分隔
SEARCH_QUOTA_WARN_RATIOS=0.5,0.75,0.9
# degrade_annotate = 额度耗尽仍出报告，但明说「本次未联网」（默认）
# hard_stop        = 额度耗尽直接拒绝新建 run
SEARCH_QUOTA_POLICY=degrade_annotate
# 软上限比例：到这里就开始在报告里提示
SEARCH_QUOTA_SOFT_CAP_RATIO=0.9
# 单次 run 的搜索次数硬顶，防止一条 run 疯狂烧积分
SEARCH_QUOTA_PER_RUN_CAP=12
# ⚠️ 请勿用 uvicorn --workers>1 启动（见 app/search/quota.py 顶部 docstring）。
# 原因不是「多 worker 会超支」——防超支靠 SQL，跨进程安全；而是 WAL 长连接
# 在多进程写入下会永久退化为只读，而配额单例没有重连路径。

# ----- Knowledge Base (RAG) -----
# SQLite 数据库文件与上传文件存放位置（相对 backend/ 目录）
KNOWLEDGE_DB_PATH=storage/knowledge.db
STORAGE_DIR=storage/documents
# 切块大小与重叠（字符）。size 太小丢上下文、太大检索不精准；
# overlap 用于避免句子被切断后两边都检索不到。
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# 一次检索默认返回几条
RETRIEVAL_TOP_K=5
# 上传文件大小上限（字节），默认 10MB
UPLOAD_MAX_BYTES=10485760

# ----- Embedding -----
# auto  = 有 Key 用真实 embedding API，没 Key 用本地哈希向量（仅保证链路可跑）
# openai= 强制真实 API   hash = 强制本地哈希向量
EMBEDDING_PROVIDER=auto
# 常见配置：
#   OpenAI    留空                                                  + text-embedding-3-small
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1     + text-embedding-v3
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# embedding 的 Key 与 LLM 的 Key 可以来自不同厂商
EMBEDDING_API_KEY=
# 本地哈希向量维度（真实模型时不生效，以模型返回为准）
EMBEDDING_DIMENSION=256
EMBEDDING_TIMEOUT_SECONDS=30
